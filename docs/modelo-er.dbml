// ---------------------------------------------------------------- Relaciones
Ref: animal.area_id > area.id
Ref: animal.especie_id > especie.id
Ref: aplicacion_clinica.animal_id > animal.id
Ref: aplicacion_clinica.consulta_id > consulta_clinica.id
Ref: aplicacion_clinica.insumo_clinico_id > insumo_clinico.id
Ref: aplicacion_clinica.veterinario_id > veterinario.usuario_id
Ref: area.habitat_id > habitat.id
Ref: bitacora.usuario_id > usuario.id
Ref: compra.anulado_por_id > usuario.id
Ref: compra.cliente_id > cliente.id
Ref: compra.vendedor_id > usuario.id
Ref: consulta_clinica.animal_id > animal.id
Ref: consulta_clinica.veterinario_id > veterinario.usuario_id
Ref: detalle_compra.compra_id > compra.id
Ref: detalle_compra.promocion_id > promocion.id
Ref: detalle_compra.tipo_entrada_id > tipo_entrada.id
Ref: dieta.alimento_id > alimento.id
Ref: dieta.animal_id > animal.id
Ref: dieta.especie_id > especie.id
Ref: dieta.veterinario_id > veterinario.usuario_id
Ref: entrada.detalle_id > detalle_compra.id
Ref: entrada.validador_id > usuario.id
Ref: horario_alimentacion.area_id > area.id
Ref: horario_alimentacion.cuidador_id > usuario.id
Ref: lote_alimento.alimento_id > alimento.id
Ref: lote_alimento.proveedor_id > proveedor.id
Ref: lote_alimento.usuario_id > usuario.id
Ref: movimiento_alimento.lote_id > lote_alimento.id
Ref: movimiento_alimento.registro_id > registro_alimentacion.id
Ref: movimiento_alimento.usuario_id > usuario.id
Ref: movimiento_clinico.aplicacion_id > aplicacion_clinica.id
Ref: movimiento_clinico.insumo_clinico_id > insumo_clinico.id
Ref: movimiento_clinico.usuario_id > usuario.id
Ref: movimiento_insumo_limpieza.insumo_limpieza_id > insumo_limpieza.id
Ref: movimiento_insumo_limpieza.tarea_id > tarea_limpieza.id
Ref: movimiento_insumo_limpieza.usuario_id > usuario.id
Ref: promocion.tipo_entrada_id > tipo_entrada.id
Ref: registro_alimentacion.animal_id > animal.id
Ref: registro_alimentacion.dieta_id > dieta.id
Ref: registro_alimentacion.horario_id > horario_alimentacion.id
Ref: registro_alimentacion.usuario_id > usuario.id
Ref: tarea_insumo.insumo_limpieza_id > insumo_limpieza.id
Ref: tarea_insumo.tarea_id > tarea_limpieza.id
Ref: tarea_limpieza.area_id > area.id
Ref: tarea_limpieza.asignado_id > usuario.id
Ref: tarea_limpieza.programado_por_id > usuario.id
Ref: tarea_limpieza.verificado_por_id > usuario.id
Ref: usuario.rol_id > rol.id
Ref: veterinario.usuario_id > usuario.id

// Núcleo: seguridad y catálogos compartidos
TableGroup Nucleo {
  rol
  usuario
  sesion
  bitacora
  veterinario
  habitat
  area
  especie
  animal
}

// Gestión de Limpieza
TableGroup Limpieza {
  insumo_limpieza
  tarea_limpieza
  tarea_insumo
  movimiento_insumo_limpieza
}

// Gestión de Alimentación
TableGroup Alimentacion {
  proveedor
  alimento
  lote_alimento
  dieta
  horario_alimentacion
  registro_alimentacion
  movimiento_alimento
}

// Control Clínico
TableGroup Clinico {
  insumo_clinico
  consulta_clinica
  aplicacion_clinica
  movimiento_clinico
}

// Gestión de Entradas y Promociones
TableGroup Entradas {
  tipo_entrada
  promocion
  cliente
  compra
  detalle_compra
  entrada
}
